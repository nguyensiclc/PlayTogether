{
  "name": "playtogether",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @playtogether/client",
    "build": "npm run build -w @playtogether/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
